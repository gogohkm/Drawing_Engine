          "id": "formula_2",
          "formula": "C = \\frac{1.12}{(D/t_{w})}\\sqrt{\\frac{E k}{F_{yw}}}$ (4.3-186)",
          "line_number": 3080,
          "line_range": [
            3075,
            3085
          ]
        },
        {
          "id": "formula_3",
          "formula": "C = \\frac{1.57}{(D/t_{w})^{2}}(\\frac{Ek}{F_{yw}})$ (4.3-187)",
          "line_number": 3084,
          "line_range": [
            3079,
            3089
          ]
        },
        {
          "id": "formula_4",
          "formula": "P = \\sqrt{{P_{p}}^{2} + {F_{p}}^{2}}$ (4.3-206)",
          "line_number": 3272,
          "line_range": [
            3267,
            3277
          ]
        },
        {
          "id": "formula_5",
          "formula": "P = \\sqrt{{P_{T}}^{2} + {F_{T}}^{2}}$ (4.3-210)",
          "line_number": 3300,
          "line_range": [
            3295,
            3305
          ]
        },
        {
          "id": "formula_6",
          "formula": "C = \\frac{\\pi(D - t)^{2}t}{2}$",
          "line_number": 4486,
          "line_range": [
            4481,
            4491
          ]
        },
        {
          "id": "formula_7",
          "formula": "C = 2(B - t)(H - t)t - 4.5(4 - \\pi)t^{3}$",
          "line_number": 4487,
          "line_range": [
            4482,
            4492
          ]
        },
        {
          "id": "formula_8",
          "formula": "P = T_{D} + T_{C})T_{D}$: 파형강판에 작용하는 고정하중에 의한 압축력 (kN/m)",
          "line_number": 5264,
          "line_range": [
            5259,
            5269
          ]
        },
        {
          "id": "formula_9",
          "formula": "M = M_{1} + M_{B} + M_{C})M_{1}$: 상부 아치 정점부까지 고정하중에 의한 휨모멘트 ($kN \\cdot m/m$)",
          "line_number": 5274,
          "line_range": [
            5269,
            5279
          ]
        }
      ],
